<div>
    <div class="header">
        <div class="pic">
            <div class="activation">
                <p>{{localize 'HUNTER.ACTIVATION'}}</p>
                <div
                    class="track"
                    data-action="toggleTracker"
                    data-value="{{system.activation.value}}"
                    data-name="activation"
                >
                    {{#for system.activation.max}}
                        <div></div>
                    {{/for}}
                </div>
            </div>
            <img src="{{actor.img}}" title="{{actor.name}}" data-action="editImage" data-edit="img"/>
            <div class="counter">
                <p>{{localize 'HUNTER.COUNTER'}}</p>
                <div
                    class="track"
                    data-action="toggleTracker"
                    data-value="{{system.counter.value}}"
                    data-name="counter"
                >
                    {{#for system.counter.max}}
                        <div></div>
                    {{/for}}
                </div>
            </div>
        </div>
        <div class="persona">
            <input name="name" type="text" placeholder="Name" value="{{actor.name}}"/>
            <prose-mirror
                name="system.desc"
                button="false"
                editable="{{editable}}"
                toggled="true"
                value="{{system.desc}}">
                {{{system.desc}}}
            </prose-mirror>
        </div>
    </div>
    <div class="aa">
        <div class="AUGMENTATION">
            <h3>{{localize 'RUNNER.AUG'}}</h3>
            <input type="text" name="system.AUGMENTATION.name" value="{{system.AUGMENTATION.name}}">
            <prose-mirror
                name="system.AUGMENTATION.desc"
                button="false"
                editable="{{editable}}"
                toggled="true"
                value="{{system.AUGMENTATION.desc}}">
                {{{system.AUGMENTATION.desc}}}
            </prose-mirror>
        </div>
        <div class="Ability">
            <h3>{{localize 'RUNNER.ABILITY'}}</h3>
            <input type="text" name="system.Ability.name" value="{{system.Ability.name}}">
            <prose-mirror
                name="system.Ability.desc"
                button="false"
                editable="{{editable}}"
                toggled="true"
                value="{{system.Ability.desc}}">
                {{{system.Ability.desc}}}
            </prose-mirror>
        </div>
    </div>
    <div class="rank">
        <div class="RANK1">
            <div class="title">
                <h3>{{localize 'HUNTER.RANK'}} 1</h3>
                <span>{{localize 'HUNTER.PICK'}} 2</span>
            </div>
            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        name="system.RANK1.row1.isUse"
                        {{#if system.RANK1.row1.isUse}}checked{{/if}}
                    >
                </label>
                <input type="text" name="system.RANK1.row1.name" value="{{system.RANK1.row1.name}}"/>
            </div>
            <div class="skill">
                <label>
                <input
                    type="checkbox"
                    name="system.RANK1.row2.isUse"
                    {{#if system.RANK1.row2.isUse}}checked{{/if}}
                >
                </label>
                <input type="text" name="system.RANK1.row2.name" value="{{system.RANK1.row2.name}}">
            </div>
            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        name="system.RANK1.row3.isUse"
                        {{#if system.RANK1.row3.isUse}}checked{{/if}}
                    >
                </label>
                <input type="text" name="system.RANK1.row3.name" value="{{system.RANK1.row3.name}}">
            </div>
            <div
                class="track"
                data-action="toggleTracker"
                data-value="{{system.RANK1.value}}"
                data-name="RANK1"
            >
                {{#for system.RANK1.max}}
                    <div></div>
                {{/for}}
            </div>
        </div>
        <div class="RANK2">
            <div class="title">
                <h3>{{localize 'HUNTER.RANK'}} 2</h3>
                <span>{{localize 'HUNTER.PICK'}} 1</span>
            </div>
            <div class="skill">
                <label>
                <input
                    type="checkbox"
                    name="system.RANK2.row1.isUse"
                    {{#if system.RANK2.row1.isUse}}checked{{/if}}
                >
                </label>
                <input type="text" name="system.RANK2.row1.name" value="{{system.RANK2.row1.name}}"/>
            </div>
            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        name="system.RANK2.row2.isUse"
                        {{#if system.RANK2.row2.isUse}}checked{{/if}}
                    >
                </label>
                <input type="text" name="system.RANK2.row2.name" value="{{system.RANK2.row2.name}}">
            </div>
            <div class="skill">
                <label>
                    <input
                        type="checkbox"
                        name="system.RANK2.row3.isUse"
                        {{#if system.RANK2.row3.isUse}}checked{{/if}}
                    >
                </label>
                <input type="text" name="system.RANK2.row3.name" value="{{system.RANK2.row3.name}}">
            </div>
            <div
                class="track"
                data-action="toggleTracker"
                data-value="{{system.RANK2.value}}"
                data-name="RANK2"
            >
                {{#for system.RANK2.max}}
                    <div></div>
                {{/for}}
            </div>
        </div>
        <div class="RANK3">
            <div class="title">
                <label>
                    <input
                        type="checkbox"
                        name="system.RANK3.isUse"
                        {{#if system.RANK3.isUse}}checked{{/if}}
                    >
                </label>
                <h3>{{localize 'HUNTER.RANK'}} 3</h3>
                <span>{{localize 'HUNTER.UPGRADE'}}</span>
            </div>
            <textarea name="system.RANK3.desc" cols="36" rows="5">{{system.RANK3.desc}}</textarea>
            <div
                class="track"
                data-action="toggleTracker"
                data-value="{{system.RANK3.value}}"
                data-name="RANK3"
            >
                {{#for system.RANK3.max}}
                    <div></div>
                {{/for}}
            </div>
        </div>
    </div>
</div>